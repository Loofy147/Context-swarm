{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scs.invalid/schemas/work-item.schema.json",
  "title": "SCS Work Item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "work_item_id",
    "kind",
    "title",
    "status",
    "source_refs",
    "target_context_ids",
    "dependencies",
    "priority",
    "acceptance_criteria",
    "attempts"
  ],
  "properties": {
    "work_item_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "kind": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "description": {
      "type": "string"
    },
    "status": {
      "enum": [
        "captured",
        "triaged",
        "ready",
        "in_progress",
        "needs_information",
        "blocked",
        "conflicted",
        "review",
        "accepted",
        "superseded",
        "rejected"
      ]
    },
    "requested_by": {
      "type": "string"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "input_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "target_context_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "priority": {
      "type": "object",
      "required": [
        "level",
        "rationale"
      ],
      "properties": {
        "level": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "required_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    },
    "blocked_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_outcome": {
      "type": "string"
    },
    "history_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "consumer_run_ref": {
      "type": "string"
    },
    "expected_context_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Version of the work-item state record; increment on every accepted state change."
    }
  }
}
