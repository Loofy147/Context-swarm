{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scs.invalid/schemas/batch-cycle-plan.schema.json",
  "title": "SCS Bounded Batch Cycle Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cycle_id",
    "base_commit",
    "base_registry_version",
    "input_count",
    "plans",
    "summary",
    "external_actions",
    "committed"
  ],
  "properties": {
    "schema_version": {
      "const": "scs.batch-cycle-plan.v1"
    },
    "cycle_id": {
      "type": "string",
      "minLength": 1
    },
    "base_commit": {
      "type": "string",
      "minLength": 7
    },
    "base_registry_version": {
      "type": "integer",
      "minimum": 1
    },
    "input_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "cycle_id",
          "base_commit",
          "base_registry_version",
          "input_ref",
          "operation",
          "intake",
          "plan_status",
          "input_record_proposal",
          "proposals",
          "blockers",
          "external_actions",
          "committed"
        ],
        "properties": {
          "schema_version": {
            "const": "scs.cycle-plan.v1"
          },
          "cycle_id": {
            "type": "string"
          },
          "base_commit": {
            "type": "string"
          },
          "base_registry_version": {
            "type": "integer"
          },
          "input_ref": {
            "type": "object"
          },
          "operation": {
            "type": "string"
          },
          "intake": {
            "type": "object"
          },
          "plan_status": {
            "type": "string"
          },
          "input_record_proposal": {
            "type": [
              "object",
              "null"
            ]
          },
          "proposals": {
            "type": "array"
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "external_actions": {
            "type": "array",
            "maxItems": 0
          },
          "committed": {
            "const": false
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposed",
        "blocked",
        "needs_information",
        "duplicate_noop",
        "review_required",
        "no_change",
        "input_records_proposed",
        "state_change_proposals"
      ],
      "properties": {
        "proposed": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        },
        "needs_information": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_noop": {
          "type": "integer",
          "minimum": 0
        },
        "review_required": {
          "type": "integer",
          "minimum": 0
        },
        "no_change": {
          "type": "integer",
          "minimum": 0
        },
        "input_records_proposed": {
          "type": "integer",
          "minimum": 0
        },
        "state_change_proposals": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "external_actions": {
      "type": "array",
      "maxItems": 0
    },
    "committed": {
      "const": false
    }
  }
}
