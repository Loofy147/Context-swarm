{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scs.invalid/schemas/github-source-snapshot.schema.json",
  "title": "Captured SCS GitHub Source Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "captured_at",
    "base_commit",
    "base_registry_version",
    "repo_full_name",
    "source_locators",
    "limitations",
    "source_snapshot"
  ],
  "properties": {
    "schema_version": {
      "const": "scs.github-source-snapshot.v1"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "base_commit": {
      "type": "string",
      "minLength": 7
    },
    "base_registry_version": {
      "type": "integer",
      "minimum": 1
    },
    "repo_full_name": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "source_locators": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_snapshot": {
      "type": "object",
      "required": [
        "repository",
        "branch_head_sha",
        "latest_commit",
        "issues_query",
        "issues",
        "workflow_run"
      ],
      "properties": {
        "repository": {
          "type": "object",
          "required": [
            "full_name",
            "html_url",
            "updated_at"
          ],
          "properties": {
            "full_name": {
              "type": "string"
            },
            "html_url": {
              "type": "string"
            },
            "updated_at": {
              "type": "string"
            }
          }
        },
        "branch_head_sha": {
          "type": "string",
          "minLength": 7
        },
        "latest_commit": {
          "type": "object",
          "required": [
            "sha",
            "html_url",
            "commit"
          ],
          "properties": {
            "sha": {
              "type": "string"
            },
            "html_url": {
              "type": "string"
            },
            "commit": {
              "type": "object",
              "required": [
                "message",
                "author"
              ],
              "properties": {
                "message": {
                  "type": "string"
                },
                "author": {
                  "type": "object",
                  "required": [
                    "date"
                  ],
                  "properties": {
                    "date": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "issues_query": {
          "type": "string",
          "minLength": 1
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "workflow_run": {
          "type": "object",
          "required": [
            "id",
            "head_sha",
            "status",
            "conclusion",
            "updated_at",
            "html_url"
          ],
          "properties": {
            "id": {
              "type": "integer"
            },
            "head_sha": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "conclusion": {
              "type": [
                "string",
                "null"
              ]
            },
            "updated_at": {
              "type": "string"
            },
            "html_url": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
