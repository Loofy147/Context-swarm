{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scs.invalid/schemas/context-state.schema.json",
  "title": "SCS Repository-Native Context State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context_id",
    "context_type",
    "title",
    "purpose",
    "lifecycle_status",
    "version",
    "relationships",
    "evidence_refs",
    "open_questions"
  ],
  "properties": {
    "context_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "context_type": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "included": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "lifecycle_status": {
      "enum": [
        "draft",
        "active",
        "blocked",
        "conflicted",
        "review",
        "accepted",
        "stale",
        "superseded",
        "archived",
        "deferred"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "target_context_id"
        ],
        "properties": {
          "type": {
            "enum": [
              "parent_of",
              "depends_on",
              "references",
              "derived_from",
              "conflicts_with",
              "supersedes",
              "shares_with"
            ]
          },
          "target_context_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "text",
          "status"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "status": {
            "enum": [
              "observed",
              "inferred",
              "proposed",
              "verified",
              "accepted",
              "stale",
              "disputed",
              "rejected"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "decision_id",
          "status",
          "statement"
        ],
        "properties": {
          "decision_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "proposed",
              "accepted",
              "rejected",
              "deferred",
              "superseded"
            ]
          },
          "statement": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies_current": {
      "enum": [
        "current",
        "stale",
        "unknown",
        "blocked"
      ]
    },
    "last_change": {
      "type": "object",
      "properties": {
        "change_note": {
          "type": "string"
        },
        "operator_run_ref": {
          "type": "string"
        },
        "commit_ref": {
          "type": "string"
        },
        "changed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "change_note": {
      "type": "string",
      "description": "Human-readable reason for the accepted context state version."
    }
  }
}
