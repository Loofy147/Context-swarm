{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://scs.invalid/schemas/context.schema.json","title":"SCS Context Envelope","type":"object","additionalProperties":false,"required":["schema_version","context_id","context_type","scope","owner_principal_id","lifecycle_status","current_version","created_at","updated_at","content_digest"],"properties":{"schema_version":{"const":"scs.context.v1"},"context_id":{"type":"string","minLength":1,"maxLength":200},"context_type":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{1,79}$"},"scope":{"type":"object","required":["purpose"],"properties":{"purpose":{"type":"string","minLength":1},"boundaries":{"type":"array","items":{"type":"string"}},"exclusions":{"type":"array","items":{"type":"string"}},"invariants":{"type":"array","items":{"type":"string"}}},"additionalProperties":false},"owner_principal_id":{"type":"string","minLength":1,"maxLength":200},"lifecycle_status":{"enum":["draft","active","blocked","archived","superseded"]},"current_version":{"type":"integer","minimum":1},"parent_refs":{"type":"array","items":{"type":"string"},"uniqueItems":true},"relationships":{"type":"array","items":{"type":"object","required":["type","target_context_id"],"properties":{"type":{"enum":["parent_of","depends_on","references","derived_from","conflicts_with","supersedes","shares_with"]},"target_context_id":{"type":"string","minLength":1}},"additionalProperties":false}},"evidence_refs":{"type":"array","items":{"type":"string"},"uniqueItems":true},"open_issues":{"type":"array","items":{"type":"object","required":["issue_id","status","description"],"properties":{"issue_id":{"type":"string"},"status":{"enum":["open","blocked","resolved"]},"description":{"type":"string"}},"additionalProperties":false}},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"},"content_digest":{"type":"object","required":["algorithm","canonicalization","value"],"properties":{"algorithm":{"const":"sha25