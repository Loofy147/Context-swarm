{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scs.invalid/schemas/capability-verification.schema.json",
  "title": "SCS Resource-Scoped Capability Verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verification_id",
    "observed_at",
    "scope",
    "universal_access_claim",
    "resources",
    "replayable_examples",
    "unverified_scopes",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "scs.capability-verification.v1"
    },
    "verification_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_item_id",
        "project",
        "baseline_commit",
        "purpose"
      ],
      "properties": {
        "work_item_id": {
          "const": "SCS-MATURE-008"
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "baseline_commit": {
          "type": "string",
          "minLength": 7
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "universal_access_claim": {
      "const": false
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "resource_id",
          "access_status",
          "observed_ref",
          "checks",
          "limitations"
        ],
        "properties": {
          "provider": {
            "enum": [
              "GitHub",
              "Notion"
            ]
          },
          "resource_id": {
            "type": "string",
            "minLength": 1
          },
          "access_status": {
            "enum": [
              "verified_read_only",
              "verified_read_write",
              "limited",
              "not_checked"
            ]
          },
          "observed_ref": {
            "type": "string",
            "minLength": 1
          },
          "permission_snapshot": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "admin": {
                "type": "boolean"
              },
              "maintain": {
                "type": "boolean"
              },
              "pull": {
                "type": "boolean"
              },
              "push": {
                "type": "boolean"
              },
              "triage": {
                "type": "boolean"
              }
            }
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "action_name",
                "capability_id",
                "permission_class",
                "operation",
                "target",
                "task_scope",
                "authorization_basis",
                "result",
                "current_schema_resolved",
                "evidence_ref"
              ],
              "properties": {
                "action_name": {
                  "type": "string",
                  "minLength": 1
                },
                "capability_id": {
                  "enum": [
                    "github.repository.read",
                    "github.repository.content_write",
                    "github.repository.privileged",
                    "connected_service.read",
                    "connected_service.write"
                  ]
                },
                "permission_class": {
                  "enum": [
                    "read",
                    "write",
                    "privileged"
                  ]
                },
                "operation": {
                  "type": "string",
                  "minLength": 1
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                },
                "task_scope": {
                  "type": "string",
                  "minLength": 1
                },
                "authorization_basis": {
                  "type": "string",
                  "minLength": 1
                },
                "result": {
                  "const": "success"
                },
                "current_schema_resolved": {
                  "const": true
                },
                "evidence_ref": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "replayable_examples": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "example_id",
          "kind",
          "scenario",
          "action_or_test",
          "replay_command",
          "expected_disposition",
          "evidence_ref"
        ],
        "properties": {
          "example_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "read_only",
              "blocked",
              "approval_gated"
            ]
          },
          "scenario": {
            "type": "string",
            "minLength": 1
          },
          "action_or_test": {
            "type": "string",
            "minLength": 1
          },
          "replay_command": {
            "type": "string",
            "minLength": 1
          },
          "expected_disposition": {
            "enum": [
              "read_succeeds_without_mutation",
              "blocked_no_state_change",
              "approval_required_before_effect"
            ]
          },
          "evidence_ref": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "unverified_scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "resource_scope",
          "disposition",
          "rationale"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "resource_scope": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "not_checked",
              "limited",
              "blocked"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
